


service firebase.storage {
  match /b/{bucket}/o {
    // Allow authenticated users to read/write their own avatar and original avatar
    match /avatars/{fileName} {
      allow read, write: if request.auth != null &&
        (request.auth.uid == fileName || request.auth.uid + "_original" == fileName);
    }
    // Allow authenticated users to read/write task images
    match /tasks/{taskId}/{fileName} {
      allow read, write: if request.auth != null;
    }
    // Allow only authenticated users to write to any property folder
    match /properties/{propertyId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Default: allow read for all files
    match /{allPaths=**} {
      allow read;
    }
  }
}
