rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users: allow any authenticated user to read, but only write their own document
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Properties: allow any authenticated user to read, but only write their own properties
    match /properties/{propertyId} {
      allow read, write, update, create, delete: if request.auth != null;
    }

    // Tasks: allow create/write/read/delete if ownerId matches current user or if the user is shared on the property
    match /tasks/{taskId} {
      allow read, write, update, create, delete: if request.auth != null;
    }
    
    // Allow test documents for connection testing
    match /test/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Invites: allow any authenticated user to create, read, and update (mark as used)
    match /invites/{inviteId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Mail: allow any authenticated user to create (for Firestore Send Email extension)
    match /mail/{mailId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
    
    // Notifications: allow create/write/read/delete if authenticated
    match /notifications/{notificationId} {
      allow read, write, update, create, delete: if request.auth != null;
    }
  }
}
